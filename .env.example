# Copy to .env and change what you need. Every setting is optional: the
# defaults in backend/src/grod/config.py are the ones compose.yml expects.
#
# All settings are read from the environment with the GROD_ prefix.

# --- what this instance calls itself ---------------------------------------
GROD_INSTANCE_NAME=Gród
# The address the instance is reached at. It is also the OpenID Connect
# issuer, so it must match what browsers actually type.
GROD_PUBLIC_URL=http://localhost:5173/

# --- data ------------------------------------------------------------------
GROD_DATABASE_URL=postgresql+asyncpg://grod:grod@postgres:5432/grod
GROD_VALKEY_URL=redis://valkey:6379/0
# The address applications reach handed-out databases at. Empty means the same
# host the platform itself connects to.
GROD_DATABASE_PUBLIC_HOST=

# --- sessions and sign-in --------------------------------------------------
# Leave false only while developing over plain HTTP. Behind TLS, set it.
GROD_SESSION_COOKIE_SECURE=false
# Passkeys belong to a domain; in development that is plain localhost.
GROD_WEBAUTHN_RP_ID=localhost

# --- outgoing email --------------------------------------------------------
# The development stack runs Mailpit, which accepts everything and shows it
# at http://localhost:8025 instead of sending it anywhere.
GROD_SMTP_HOST=mailpit
GROD_SMTP_PORT=1025
GROD_SMTP_USE_TLS=false
GROD_EMAIL_FROM=accounts@grod.local

# --- where the platform keeps things ---------------------------------------
# Repositories, packages, container images, bucket files and published sites.
# One volume is enough; these are folders inside it.
GROD_REPOSITORIES_PATH=var/repositories
GROD_PACKAGES_PATH=var/packages
GROD_REGISTRY_PATH=var/registry
GROD_STORAGE_PATH=var/storage
GROD_PAGES_PATH=var/pages

# --- what one account may hold --------------------------------------------
GROD_QUOTA_STORAGE_BYTES=5368709120
GROD_QUOTA_BUCKETS=20
GROD_QUOTA_APPLICATIONS=10
GROD_QUOTA_FUNCTIONS=50
GROD_QUOTA_DATABASES=10
GROD_QUOTA_QUEUES=20
GROD_QUOTA_WORKSPACES=3

# --- Git over SSH ----------------------------------------------------------
# Port 22 needs privileges, so the compose stack publishes 2222.
GROD_SSH_PORT=2222
GROD_SSH_USER=git

# --- host ports of the backing services ------------------------------------
# Changed only because a development machine usually has these taken already.
POSTGRES_PORT=5433
VALKEY_PORT=6380
SMTP_PORT=1025
MAILPIT_PORT=8025
POSTGRES_USER=grod
POSTGRES_PASSWORD=grod
POSTGRES_DB=grod
